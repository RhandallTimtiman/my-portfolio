<div class="reading-progress" aria-hidden="true"></div>

<script>
  const preference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const pointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  const progress = document.querySelector<HTMLElement>(".reading-progress");
  const animations = new Set<Animation>();
  let observer: IntersectionObserver | undefined;

  const reveal = (element: HTMLElement, delay = 0) => {
    const animation = element.animate(
      [
        { opacity: 0, transform: "translateY(28px)" },
        { opacity: 1, transform: "none" },
      ],
      {
        duration: 750,
        delay,
        easing: "cubic-bezier(.22,1,.36,1)",
        fill: "backwards",
      },
    );
    animations.add(animation);
    animation.finished.then(() => animations.delete(animation)).catch(() => {});
  };

  const setupReveals = () => {
    observer?.disconnect();
    animations.forEach((animation) => animation.cancel());
    animations.clear();
    if (preference.matches) return;

    observer = new IntersectionObserver(
      (entries) => {
        let stagger = 0;
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const element = entry.target as HTMLElement;
          observer?.unobserve(element);
          if (element.dataset.motionSeen) return;
          element.dataset.motionSeen = "true";
          reveal(element, stagger++ * 70);
        });
      },
      { threshold: 0, rootMargin: "0px 0px -40px 0px" },
    );

    // Animate content, never the timeline's sticky positioning containers.
    document
      .querySelectorAll<HTMLElement>(
        " .hero-intro > p, .hero-intro > h1, .hero-actions, .field-index > a, [data-reveal] h2, #about h2 + div > p, [data-project], [data-skill], [data-metric-value], [data-experience-item] > div:last-child, #contact > div > a",
      )
      .forEach((element) => observer?.observe(element));
  };
  setupReveals();
  preference.addEventListener("change", setupReveals);

  let scheduled = false;
  const updateProgress = () => {
    scheduled = false;
    const range = document.documentElement.scrollHeight - window.innerHeight;
    const fraction =
      range > 0 ? Math.max(0, Math.min(1, window.scrollY / range)) : 0;
    progress?.style.setProperty("--progress", String(fraction));
  };
  const scheduleProgress = () => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(updateProgress);
  };
  window.addEventListener("scroll", scheduleProgress, { passive: true });
  window.addEventListener("resize", scheduleProgress);
  new ResizeObserver(scheduleProgress).observe(document.body);
  updateProgress();

  document.querySelectorAll<HTMLElement>("[data-project]").forEach((card) => {
    card.addEventListener("pointermove", (event) => {
      if (preference.matches || !pointer.matches) return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--pointer-x", `${event.clientX - rect.left}px`);
      card.style.setProperty("--pointer-y", `${event.clientY - rect.top}px`);
    });
  });

  document.querySelectorAll<HTMLElement>("#top a").forEach((button) => {
    button.addEventListener("pointermove", (event) => {
      if (preference.matches || !pointer.matches) return;
      const rect = button.getBoundingClientRect();
      button.style.translate = `${(event.clientX - rect.left - rect.width / 2) * 0.08}px ${(event.clientY - rect.top - rect.height / 2) * 0.15}px`;
    });
    const reset = () => {
      button.style.translate = "";
    };
    button.addEventListener("pointerleave", reset);
    button.addEventListener("blur", reset);
    preference.addEventListener("change", reset);
  });
</script>

<style is:global>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    pointer-events: none;
  }

  #top {
    position: relative;
    isolation: isolate;
  }
  #top a {
    transition:
      translate 180ms ease,
      transform 300ms ease,
      background-color 300ms ease;
  }
  [data-project] {
    isolation: isolate;
  }
  [data-project]::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      400px circle at var(--pointer-x, 50%) var(--pointer-y, 50%),
      rgb(100 100 100 / 12%),
      transparent 75%
    );
    opacity: 0;
    transition: opacity 350ms ease;
  }
  [data-project]:focus-within::after {
    opacity: 1;
  }
  [aria-label="Technologies"] li {
    transition:
      transform 200ms ease,
      border-color 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    [data-project]:hover::after {
      opacity: 1;
    }
    [aria-label="Technologies"] li:hover {
      transform: translateY(-3px);
      border-color: currentColor;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orbit {
      animation: none;
    }
    #top a,
    [data-project],
    [data-project]::after,
    [data-skill],
    [aria-label="Technologies"] li {
      transition: none;
    }
    [aria-label="Technologies"] li:hover {
      transform: none;
    }
    [data-project]::after {
      display: none;
    }
  }
</style>
