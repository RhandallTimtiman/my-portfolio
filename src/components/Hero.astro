---
import type { Profile } from "../data/portfolio";
import { experience, socialLinks } from "../data/portfolio";
interface Props { profile: Profile }
const { profile } = Astro.props;
---
<section id="top" aria-labelledby="hero-title" class="notebook-hero">
  <div class="hero-intro">
    <p class="eyebrow">{profile.name} / {profile.location}</p>
    <h1 id="hero-title">Senior Flutter<br />&amp; <em>Full Stack<br />Developer.</em></h1>
    <p class="hero-description">I build the systems behind medicine deliveries, remote consultations, and port operations. From the Flutter app in someone’s hand to the services behind it.</p>
    <div class="hero-actions"><a href="#contributions">Key contributions <span aria-hidden="true">↓</span></a><a href="#dispatch-study">Read a case study <span aria-hidden="true">↘</span></a><a href={`mailto:${profile.email}`}>Email me <span aria-hidden="true">↗</span></a></div>
    <p class="hero-byline">{experience[0].title} · {experience[0].company}<br />Flutter / Dart · .NET · Native mobile integrations</p>
    {socialLinks.filter((link) => link.label === "LinkedIn" && link.href).map((link) => <a class="profile-link" href={link.href} target="_blank" rel="noreferrer">LinkedIn profile ↗<span class="sr-only"> (opens in a new tab)</span></a>)}
  </div>
  <aside class="field-index" aria-label="Selected engineering work">
    <p class="eyebrow">The work, in three contexts</p>
    <a href="#dispatch-study"><span class="index-no">01 / Delivery</span><strong>A job fails.<br />What happens next?</strong><span>API migration · Queues · Retries ↗</span></a>
    <a href="#project-02"><span class="index-no">02 / Care</span><strong>A consultation.<br />Across a distance.</strong><span>Flutter · Video · Prescriptions ↗</span></a>
    <a href="#project-03"><span class="index-no">03 / Port operations</span><strong>A paper process.<br />Made mobile.</strong><span>Digital EIR · Flutter · APIs ↗</span></a>
    <p class="index-note">Mobile interfaces. Backend decisions.<br />The connections between them.</p>
  </aside>
</section>
<style>
  .notebook-hero { max-width:1280px; margin:auto; padding:160px 16px 72px; display:grid; grid-template-columns:1.65fr 1fr; gap:80px; align-items:center; min-height:95svh; }
  .eyebrow,.hero-byline,.field-index span,.index-note { font-family:monospace; font-size:.7rem; line-height:1.8; }
  .eyebrow { text-transform:uppercase; letter-spacing:.12em; }
  h1 { font-size:clamp(3.5rem,6.5vw,6.8rem); letter-spacing:-.065em; line-height:.99; margin:36px 0; font-weight:500; }
  h1 em { font-family:Georgia,serif; font-weight:400; color:var(--ink-accent); }
  .hero-description { max-width:48ch; font-size:1.05rem; line-height:1.8; color:var(--ink-muted); }
  .hero-actions { display:flex; flex-wrap:wrap; gap:24px; margin:32px 0 40px; }
  .hero-actions a { border-bottom:1px solid currentColor; padding:12px 0; text-decoration:none; font-size:.85rem; }
  .hero-actions span { margin-left:18px; }
  .hero-byline { color:var(--ink-muted); }
  .profile-link { font-size:.8rem; text-underline-offset:5px; }
  .field-index { border-top:2px solid var(--ink-accent); }
  .field-index > .eyebrow { margin:20px 0; }
  .field-index a { display:block; text-decoration:none; padding:24px 0; border-bottom:1px solid var(--ink-line); transition:padding 250ms ease; }
  .field-index a:hover { padding-left:12px; }
  .field-index span { display:block; color:var(--ink-muted); }
  .field-index .index-no { color:var(--ink-accent); text-transform:uppercase; }
  .field-index strong { display:block; font-size:1.65rem; letter-spacing:-.035em; line-height:1.2; font-weight:500; margin:12px 0; }
  .index-note { margin-top:24px; color:var(--ink-muted); }
  @media(max-width:900px) { .notebook-hero { grid-template-columns:1fr; gap:40px; padding-top:125px; } .field-index strong br { display:none; } }
  @media(prefers-reduced-motion:reduce) { .field-index a { transition:none; } }
</style>
