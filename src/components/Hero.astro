---
import type { Profile } from "../data/portfolio";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const headline = "Senior Flutter Developer.\nFull Stack Engineer.";
const buttonBase =
  "group inline-flex min-h-12 items-center justify-between gap-4 border px-5 py-3.5 font-mono text-[0.73rem] font-semibold uppercase tracking-[0.08em] no-underline outline-offset-4 transition-all duration-300 hover:-translate-y-0.5 focus-visible:outline-2 motion-reduce:transform-none motion-reduce:transition-none";
---

<section
  class="grid min-h-svh scroll-mt-[72px] items-end pt-32 pb-12 sm:pt-36"
  id="top"
  aria-labelledby="hero-title"
>
  <div
    class="mx-auto w-[min(calc(100%_-_1.25rem),1280px)] sm:w-[min(calc(100%_-_2rem),1280px)]"
  >
    <p
      class="inline-flex items-center gap-2.5 font-mono text-[0.7rem] font-medium uppercase tracking-[0.14em] text-[#555] before:size-1.5 before:rounded-full before:bg-[#111] before:content-[''] dark:text-[#aaa] dark:before:bg-white"
    >
      {profile.availability}
    </p>
    <h1
      aria-label="Senior Flutter Developer. Full Stack Engineer."
      class="relative my-7 max-w-[15ch] text-[clamp(3rem,14vw,4.8rem)] leading-[0.92] font-medium tracking-[-0.065em] min-[621px]:text-[clamp(3.5rem,8vw,7.4rem)]"
      id="hero-title"
      data-typing-heading
    >
      <span aria-hidden="true" class="invisible whitespace-pre-line"
        >{headline}</span
      >
      <span aria-hidden="true" class="absolute inset-0">
        <span class="whitespace-pre-line" data-typed-output>{headline}</span><span
          class="ml-1 hidden h-[0.75em] w-[2px] animate-pulse bg-current align-baseline"
          data-typing-cursor></span>
      </span>
    </h1>
    <div
      class="grid items-end gap-10 min-[901px]:grid-cols-[1fr_minmax(280px,440px)] min-[901px]:gap-12"
    >
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class={`${buttonBase} flex-1 border-[#111] bg-[#111] text-[#f2f1ed] hover:border-[#333] hover:bg-[#333] sm:flex-none dark:border-[#f5f5f5] dark:bg-[#f5f5f5] dark:text-[#080808] dark:hover:border-[#d9d9d9] dark:hover:bg-[#d9d9d9]`}
          href="#projects"
          >View projects <span
            class="transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true">↘</span
          ></a
        >
        <a
          class={`${buttonBase} flex-1 border-[#aaa9a3] sm:flex-none dark:border-[#383838] dark:hover:border-[#888]`}
          href={`mailto:${profile.email}`}
          >Contact me <span
            class="transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true">→</span
          ></a
        >
      </div>
      <p
        class="m-0 text-[clamp(1rem,1.6vw,1.2rem)] leading-7 text-[#4d4d4d] dark:text-[#adadad]"
      >
        {profile.name} {profile.summary}
      </p>
    </div>
    <div
      class="mt-12 flex justify-between border-t border-black/15 pt-10 font-mono text-[0.68rem] font-medium uppercase tracking-[0.1em] text-[#666] sm:mt-16 dark:border-white/15 dark:text-[#6f6f6f]"
      aria-hidden="true"
    >
      <span>Based in {profile.location}</span>
      <span class="hidden sm:inline">Scroll to explore ↓</span>
    </div>
  </div>
</section>

<script>
  const heading = document.querySelector<HTMLElement>("[data-typing-heading]");
  const output = heading?.querySelector<HTMLElement>("[data-typed-output]");
  const cursor = heading?.querySelector<HTMLElement>("[data-typing-cursor]");
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (heading && output && cursor && !reducedMotion) {
    const text = output.textContent ?? "";
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;

        observer.disconnect();
        output.textContent = "";
        cursor.classList.remove("hidden");
        cursor.classList.add("inline-block");
        let index = 0;
        const interval = window.setInterval(() => {
          index += 1;
          output.textContent = text.slice(0, index);
          if (index >= text.length) {
            window.clearInterval(interval);
            cursor.classList.add("hidden");
            cursor.classList.remove("inline-block");
          }
        }, 28);
      },
      { threshold: 0.25 },
    );

    observer.observe(heading);
  }
</script>
